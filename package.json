{
  "name": "ai-chat-parser",
  "version": "1.0.0",
  "description": "Converts ChatGPT conversations to JSON, enabling them to be used easily in software projects",
  "repository": {
    "type": "git",
    "url": "https://github.com/anousheh21/ai-chat-parser.git"
  },
  "homepage": "https://github.com/anousheh21/ai-chat-parser#readme",
  "bugs": "https://github.com/anousheh21/ai-chat-parser/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "./dist/index.js",
    "./dist/index.d.ts",
    "./dist/services/",
    "./dist/types",
    "./dist/index.js.map",
    "./dist/index.d.ts.map",
    "./src/index.ts",
    "./src/services/",
    "./src/types/"
  ],
  "scripts": {
    "build": "tsc",
    "prebuild": "npm run clean",
    "prepack": "npm run build",
    "clean": "node -e \"require('node:fs').rmSync('./dist', { recursive: true, force: true })\"",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "keywords": ["ChatGPT", "conversation", "chat", "json", "json-parser", "ai-chat"],
  "author": "Anousheh Hasan",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "turbo-stream": "^2.4.1"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
